{
  "name": "dsh-plugin-evoforge",
  "version": "0.1.0",
  "description": "Auditable tool and skill evolution for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/doublezerolv-lab/dsh-plugin-evoforge.git" },
  "homepage": "https://github.com/doublezerolv-lab/dsh-plugin-evoforge#readme",
  "bugs": { "url": "https://github.com/doublezerolv-lab/dsh-plugin-evoforge/issues" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": "./dist/index.js", "./core": "./dist/core.js" },
  "bin": { "evoforge": "dist/cli.js" },
  "files": ["dist", "src", "tests", "tsconfig*.json", "cordis.patch.yml", "README.md", "README.en.md", "docs", "sandbox", "examples", "benchmark", "scripts", "dev.cmd", "PLAN.md"],
  "engines": { "node": ">=22" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx examples/observe-demo.ts",
    "benchmark": "tsx benchmark/run.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6"
  }
}
